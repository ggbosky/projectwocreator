# Edge Function secrets — set with:  supabase secrets set --env-file supabase/functions/.env
# (Alternatively an admin can store the API keys encrypted in Supabase Vault from the app's Settings page.)
ANTHROPIC_API_KEY=
APIFY_TOKEN=
YOUTUBE_API_KEY=
CRM_WEBHOOK_SECRET=
# Optional
CLAUDE_MODEL=claude-opus-5-5
APP_ORIGIN=https://your-app-domain.example
APP_URL=https://your-app-domain.example
AI_RATE_LIMIT_PER_HOUR=60
RADAR_RATE_LIMIT_PER_HOUR=20
FAL_KEY=
REPLICATE_API_TOKEN=
MEDIA_RATE_LIMIT_PER_HOUR=40
