# ─────────────────────────────────────────────────────────────────────────────
# Project Two — Creator Studio · frontend config
# Copy to `.env.local` and fill in. EVERYTHING prefixed VITE_ is bundled into
# the browser and is therefore PUBLIC. Never put AI / Apify / service keys here.
# ─────────────────────────────────────────────────────────────────────────────

# "demo"     → local login + data in localStorage + local AI engine (no backend)
# "supabase" → Supabase Auth + Postgres (RLS) + Edge Functions with Claude
VITE_AUTH_MODE=demo

# ── Supabase (required when VITE_AUTH_MODE=supabase) ─────────────────────────
# Project Settings → API. The anon key is public by design; RLS protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Demo login (only used when VITE_AUTH_MODE=demo) ──────────────────────────
VITE_DEMO_USERNAME=admin
VITE_DEMO_NAME=Admin
# SHA-256 of your demo password. Generate with:
#   npm run hash-password -- "VaseSilneHeslo"
# Leave empty to use the built-in default password.
VITE_DEMO_PASSWORD_HASH=

# ── Project Two CRM ──────────────────────────────────────────────────────────
# Demo mode only: posts content JSON straight to this webhook (Make/n8n/Zapier).
# In supabase mode the URL is set in-app (Settings) and requests are signed server-side.
VITE_CRM_WEBHOOK_URL=
VITE_CRM_DASHBOARD_URL=https://ggbosky.github.io/projectwodashboard/

# ── Hosting ──────────────────────────────────────────────────────────────────
# Base path when served from a sub-folder, e.g. GitHub Pages: /projectwocreator/
VITE_BASE_PATH=/
